# Goal: side length of the square. 0 -> use the server default_side_length parameter
float32 side_length
---
# Result
bool success
uint8 goals_completed    # how many goToPose goals finished (4 on success)
string message
---
# Feedback
uint8 current_side       # 1..4 (0 while resetting)
string status
float32 distance_remaining   # distance left on the current side
